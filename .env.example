# =============================================================
#  Plugin SMS — required environment variables
# =============================================================
#
#  ⚠️  This file is NOT read by the plugin.
#
#  The real .env lives at the FRAMEWORK root, next to its
#  composer.json:
#
#      <framework>/.env
#
#  Copy these variables there (or use the framework's
#  .env.example as a base, which already includes them).
#
#  Never commit the real .env to git — it contains secrets.
#  This .env.example is safe to commit (no values).
# =============================================================

# --- SMS Provider ---
# Configurable SMS provider. The example values below are for
# EZ4U, the first supported provider.
#
# The SMS_PROVIDER_* names are generic on purpose. If you switch
# to another provider, change the URL and (if needed) adapt
# SmsService::cUrl() — the rest of the plugin stays the same.
SMS_PROVIDER_URL=https://dashboard.ez4uteam.com/api/wrappers/ez4u/sendSMS
SMS_PROVIDER_ACCOUNT=Onidesk # you will need to create an accout (not free)
SMS_PROVIDER_KEY=          # API licensekey (NOT the dashboard password)
SMS_PROVIDER_SENDER=Onidesk
SMS_PROVIDER_ENVIO24=1
SMS_PROVIDER_TTL=24